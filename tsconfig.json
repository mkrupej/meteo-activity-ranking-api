{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "esModuleInterop": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true
  },
  "include": [
    "features/**/*.ts",
    "tests/**/*.ts"
  ]
}